# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------
# shellcheck disable=SC1090 # sourced at runtime via ~; not resolvable statically
source ~/.config/xcloud/scripts/xcloud-shell-aliases

# -----------------------------------------------------
# aiOS
# -----------------------------------------------------
aios-code() {
  local bin pw url=http://127.0.0.1:3901
  bin=$(find /opt/aios/opencode/node_modules/.pnpm -maxdepth 6 -path '*opencode-linux-x64/bin/opencode' -type f 2>/dev/null | head -1)
  if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "aios-code: pinned opencode binary not found under /opt/aios/opencode" >&2
    return 1
  fi
  pw=$(sudo grep -oP 'AIOS_OPENCODE_SERVER_PASSWORD=\K.*' /opt/aios/config/aios.env)
  if [ -z "$pw" ]; then
    echo "aios-code: could not read AIOS_OPENCODE_SERVER_PASSWORD" >&2
    return 1
  fi
  if [ "$1" = "--continue" ] || [ "$1" = "--attach" ]; then
    shift
    OPENCODE_SERVER_PASSWORD="$pw" "$bin" attach "$url" --continue "$@"
  else
    OPENCODE_SERVER_PASSWORD="$pw" "$bin" attach "$url" "$@"
  fi
}
