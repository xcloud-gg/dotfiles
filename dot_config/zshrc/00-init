# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR=nvim
export ZSH="$HOME/.oh-my-zsh"

# Idempotent PATH append: 00-init can run more than once per shell session
# (nested subshells, `bash -c`/`zsh -c` calls from Quickshell widgets,
# etc.), and an unconditional append here grows PATH by these entries every
# time, eventually hitting the kernel's ARG_MAX and breaking new process
# spawns.
_xcloud_path_append() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$PATH:$1" ;;
    esac
}
_xcloud_path_append "$HOME/.cargo/bin"
_xcloud_path_append "$HOME/.local/bin"
export PATH
unset -f _xcloud_path_append
