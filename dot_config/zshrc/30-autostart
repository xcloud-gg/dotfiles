# The 'ff' command (Fuzzy Finder)
finder() {
    # xcloud-finder is part of the Hyprland side's `xcloud` app, not this repo
    # (see xcloud-gg/dotfiles' README) — fail with a clear message rather than
    # a bare "command not found" if it's missing, e.g. on a CLI-guest session.
    if [ ! -x "$HOME/.config/xcloud/bin/xcloud-finder" ]; then
        echo "finder: ~/.config/xcloud/bin/xcloud-finder not found (that helper" >&2
        echo "isn't part of this rice yet — see xcloud-gg/dotfiles' README)" >&2
        return 1
    fi
    # Run the script and capture the result
    local result=$($HOME/.config/xcloud/bin/xcloud-finder)

    # Check if the script told us to CD
    if [[ "$result" == TYPE_DIR:* ]]; then
        local target_dir="${result#TYPE_DIR:}"
        cd "$target_dir" && ls
    elif [[ "$result" == TYPE_FILE:* ]]; then
    # Check if we have a file
        ${EDITOR:-nano} "${result#TYPE_FILE:}"
    else
    # Return an error
        echo "Could not read $result" >&2
        return 1
    fi
}

# The 'y' command (Yazi, cd on exit)
y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# -----------------------------------------------------
# Fastfetch
# -----------------------------------------------------
if [[ $(tty) == *"pts"* ]] && command -v fastfetch >/dev/null 2>&1; then
    if [ ! -f $HOME/.config/xcloud/settings/hide-fastfetch ]; then
        # Disable terminal auto-wrap (DECAWM) for the run so a line that's
        # wider than a narrow/tiled terminal (e.g. the cpu line's clock
        # speed) clips at the right edge instead of wrapping and breaking
        # the box-drawing layout onto a second row.
        printf '\e[?7l'; fastfetch; printf '\e[?7h'
    fi
fi
