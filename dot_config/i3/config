# xCloud i3 config — Baldr/Debian X11 rice
# Same palette/fonts as the xcloud Hyprland rice: colours are generated from
# the wallpaper by matugen (xcloud-wallpaper / waypaper) into colors.conf;
# the shipped one is rendered from the default forest2.jpg.
# fonts: JetBrainsMono Nerd Font (mono/icons) · Fira Sans (UI)

set $mod Mod4
font pango:Fira Sans 10

# Window border colours (client.*), generated by matugen from the wallpaper
include ~/.config/i3/colors.conf

# Hyprland follows the mouse (input.follow_mouse = 1), but here the Quickshell
# overlays (launcher, power menu, calendar, sidebar) are ordinary windows that
# close when they lose focus: with focus following the mouse, just brushing
# the pointer past the launcher onto a window closes it. On Hyprland they hold
# a focus grab and only close on a click outside, which is what `no` gives.
focus_follows_mouse no

# ---- keybindings ----
# Mirrors the Hyprland rice (hypr/conf/keybindings/default.lua): same combos,
# nearest i3/X11 action. "HYPR-ONLY" = no equivalent here yet (kept as a
# comment so the combo stays reserved). The bar/popups are the Quickshell
# shell (~/.config/quickshell), driven through `qs ipc call ...` like on
# Hyprland.
# Differences from i3 defaults (re-homed so Hyprland's layout wins):
#   focus mode_toggle  $mod+space       -> $mod+shift+space
#   kill               $mod+shift+q     -> $mod+q
#   floating toggle    $mod+shift+space -> $mod+t
#   move window        $mod+shift+arrow -> $mod+alt+arrow  (shift+arrow = resize)
#   layout toggle split $mod+e          -> $mod+j
#   split v            $mod+v           -> $mod+shift+v
#   layout stacking    $mod+s           -> $mod+shift+g
#   reload             $mod+shift+c     -> $mod+ctrl+r
#   lock               $mod+l           -> $mod+ctrl+l
#   power menu         $mod+shift+e     -> $mod+ctrl+p
set $term kitty
set $menu rofi -show drun -config ~/.config/rofi/config-i3.rasi
set $s ~/.config/i3/scripts

# ---- applications ----
bindsym $mod+Return exec $term
bindsym $mod+b exec zen
bindsym $mod+e exec nautilus --new-window
# HYPR-ONLY SUPER+CTRL+E emoji picker (Emote flatpak; no picker installed)
bindsym $mod+c exec gnome-calculator
# SUPER+SPACE: same launcher script as Hyprland -- rofi by default, the
# Quickshell launcher when ~/.config/xcloud/settings/launcher says "quickshell"
bindsym $mod+space exec --no-startup-id $s/launcher.sh
bindsym $mod+d exec $menu
bindsym $mod+shift+d exec rofi -show run -config ~/.config/rofi/config-i3.rasi

# ---- windows ----
floating_modifier $mod
tiling_drag modifier titlebar
bindsym $mod+q kill
bindsym $mod+shift+q exec --no-startup-id $s/kill-app.sh
bindsym $mod+f fullscreen toggle
# HYPR-ONLY SUPER+M maximize (i3 has no maximize; $mod+f / $mod+g are closest)
bindsym $mod+t floating toggle
bindsym $mod+shift+t [workspace="__focused__"] floating toggle
bindsym $mod+Mod1+t floating toggle; sticky toggle
bindsym $mod+shift+space focus mode_toggle
# HYPR-ONLY SUPER+O toggle window opacity (picom rule; no per-window toggle wired up)
bindsym $mod+j layout toggle split
# HYPR-ONLY SUPER+K swapsplit (no i3 equivalent)
bindsym $mod+g layout toggle tabbed split
bindsym $mod+shift+g layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+h split h
bindsym $mod+shift+v split v
bindsym $mod+a focus parent

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+shift+Left resize shrink width 100 px or 5 ppt
bindsym $mod+shift+Right resize grow width 100 px or 5 ppt
bindsym $mod+shift+Up resize shrink height 100 px or 5 ppt
bindsym $mod+shift+Down resize grow height 100 px or 5 ppt

bindsym $mod+Mod1+Left move left
bindsym $mod+Mod1+Down move down
bindsym $mod+Mod1+Up move up
bindsym $mod+Mod1+Right move right

bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left  resize shrink width 10 px or 10 ppt
    bindsym Down  resize grow height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ---- workspaces ----
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Hyprland's movetoworkspace follows the window, so these do too
bindsym $mod+shift+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+shift+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+shift+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+shift+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+shift+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+shift+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+shift+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+shift+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+shift+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+shift+0 move container to workspace number $ws10; workspace number $ws10

bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

# scratchpad (Hyprland special:scratchpad)
bindsym $mod+s scratchpad show
bindsym $mod+shift+s move scratchpad

# ---- session ----
bindsym $mod+ctrl+r reload
bindsym $mod+shift+c reload
bindsym $mod+shift+r restart
bindsym $mod+ctrl+l exec --no-startup-id $s/lock.sh
bindsym $mod+l exec --no-startup-id $s/lock.sh
bindsym $mod+ctrl+p exec --no-startup-id qs ipc call power toggle
# i3's usual exit combo keeps the rofi power menu as a fallback
bindsym $mod+shift+e exec --no-startup-id $s/rofi-powermenu.sh
bindsym $mod+ctrl+k exec --no-startup-id $s/keybindings.sh
# qs -p ~/.config/quickshell/overview ipc call overview toggle
bindsym $mod+Tab exec rofi -show window -config ~/.config/rofi/config-i3.rasi

# ---- screenshots ----
bindsym Print exec --no-startup-id $s/screenshot.sh --instant
bindsym $mod+Print exec --no-startup-id $s/screenshot.sh
bindsym $mod+Mod1+f exec --no-startup-id $s/screenshot.sh --instant
bindsym --release $mod+Mod1+s exec --no-startup-id $s/screenshot.sh --instant-area
# HYPR-ONLY SUPER+SHIFT+Print screen recording (no recorder installed)
# HYPR-ONLY SUPER+ALT+A OCR text extractor (no tesseract installed)

# ---- desktop / bar ----
# Wallpaper: waypaper (feh backend) runs xcloud-wallpaper as its post_command,
# which re-themes everything (matugen) from the new image.
bindsym $mod+ctrl+w exec waypaper
bindsym $mod+shift+w exec --no-startup-id ~/.config/xcloud/scripts/xcloud-wallpaper --random
# HYPR-ONLY SUPER+ALT+W wallpaper automation
# SUPER+SHIFT+B restarts the whole Quickshell shell (same script as autostart)
bindsym $mod+shift+b exec --no-startup-id $s/quickshell.sh
bindsym $mod+ctrl+b exec --no-startup-id qs ipc call statusbar toggle
# HYPR-ONLY SUPER+ALT+B statusbar autohide (an i3 dock always reserves its
# full height, so a bar that floats over windows can't exist here)
# HYPR-ONLY SUPER+CTRL+D / SUPER+ALT+D dock toggle / autohide (no dock on i3)
# HYPR-ONLY SUPER+SHIFT+A toggle animations; SUPER+ALT+G game mode
# HYPR-ONLY SUPER+CTRL+T bar theme switcher; SUPER+SHIFT+M light/dark toggle; CTRL+ALT+T theme picker
# SUPER+SHIFT+H night light: gammastep (hyprsunset on Hyprland)
bindsym $mod+shift+h exec --no-startup-id $s/nightlight.sh
bindsym $mod+ctrl+s exec --no-startup-id qs ipc call sidebar toggle
bindsym $mod+ctrl+c exec --no-startup-id qs ipc call calendar toggle
# Hyprland: expand the bar + keyboard navigation. i3 never gives a dock the
# keyboard, so here it only toggles the expanded pill.
bindsym $mod+Mod1+space exec --no-startup-id qs ipc call statusbar focus

# ---- clipboard / notes ----
# SUPER+V clipboard history: copyq (clipmenu is also installed for minimal
# setups, with clipmenud left disabled so the two don't both own the clipboard)
bindsym $mod+v exec --no-startup-id copyq toggle
bindsym $mod+n exec --no-startup-id sh -c 'mkdir -p ~/.docs && exec kitty --class notebook -d ~/.docs nvim'
bindsym $mod+shift+n exec --no-startup-id $s/quicknote.sh

# ---- media keys (i3lock grabs the keyboard, so these don't work while locked) ----
# Each runs the real command, then shows the Quickshell OSD (as on Hyprland).
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && qs ipc call osd showVolume
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && qs ipc call osd showVolume
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && qs ipc call osd showVolume
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && qs ipc call osd showMic
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -e4 -n2 set 5%+ && qs ipc call osd showBrightness
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e4 -n2 set 5%- && qs ipc call osd showBrightness
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ---- gaps / borders ----
# Hyprland: gaps_in 10 (per window side -> 20 between windows), gaps_out 20.
# i3: inner = between windows and to the screen edge, outer is added on top.
gaps inner 20
gaps outer 0
default_border pixel 2
default_floating_border pixel 2
smart_borders on

# ---- bar (the Quickshell shell owns the actual bar; keep i3bar off) ----
# polybar's config (~/.config/polybar) is still shipped but no longer started;
# to go back, swap the quickshell.sh exec_always below for
#   exec_always --no-startup-id ~/.config/polybar/launch.sh
bar {
    mode invisible
}

# ---- Quickshell overlays ----
# The shell's Power/Calendar/Launcher/Sidebar windows are plain X11 windows
# with these fixed titles; they float borderless on every workspace and place
# themselves (see ~/.config/quickshell/CustomTheme/OverlayWindow.qml).
for_window [title="^xcloud-(power|calendar|launcher|sidebar)$"] floating enable, border pixel 0, sticky enable

# ---- autostart ----
# Quickshell shell: status bar + power menu/calendar/launcher/sidebar/OSD.
# exec_always + `qs kill` in the script: an i3 restart restarts the shell.
exec_always --no-startup-id $s/quickshell.sh
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id dunst
# Wallpaper: the last one set (~/.cache/xcloud/hyprland-dotfiles/current_wallpaper),
# else /usr/share/backgrounds/xcloud/forest2.jpg; also recreates the blurred/
# square variants (lock screen, rofi) if they are missing.
exec --no-startup-id ~/.config/xcloud/scripts/xcloud-wallpaper --restore
exec --no-startup-id xsettingsd
exec --no-startup-id lxpolkit
exec --no-startup-id blueman-applet
# Night light on the Hyprland rice's day/night schedule (07:00 / 19:00),
# see ~/.config/gammastep/config.ini; SUPER+SHIFT+H toggles it.
exec --no-startup-id gammastep
# --indicator: StatusNotifierItem instead of an XEmbed icon -- the Quickshell
# tray only hosts SNI items (XEmbed-only tray icons won't show up)
exec --no-startup-id nm-applet --indicator
exec --no-startup-id copyq --start-server
# Idle (hypridle): dim at 8 min, lock at 10, screen off at 11, lock before
# sleep -- xset timeouts + xss-lock, all set up by idle.sh (the Quickshell
# bar's lock button toggles the same script).
exec --no-startup-id $s/idle.sh on
