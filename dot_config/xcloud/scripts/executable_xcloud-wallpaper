#!/usr/bin/env bash
# Set the wallpaper and re-theme the desktop from it -- X11/i3 port of the
# Hyprland rice's xcloud-wallpaper: feh instead of awww, no wallpaper effects,
# and the reloads are matugen post_hooks (~/.config/matugen/config.toml:
# kitty, tmux, i3, dunst, gtk, Quickshell). waypaper runs this as its
# post_command with --skip (waypaper has already set the image with feh).

# ============================================================
# Variables
# ============================================================
IMAGE_PATH=""
NOTIFICATIONS=false
SKIP_WALLPAPER=false
SKIP_THEMING=false
RESTORE=false
CACHE_FOLDER="$HOME/.cache/xcloud/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
SYSTEM_WALLPAPER_FOLDER="/usr/share/backgrounds/xcloud"
DEFAULT_WALLPAPER="$SYSTEM_WALLPAPER_FOLDER/forest2.jpg"
BLURRED_WALLPAPER="$CACHE_FOLDER/blurred_wallpaper.png"
SQUARE_WALLPAPER="$CACHE_FOLDER/square_wallpaper.png"
RASI_FILE="$CACHE_FOLDER/current_wallpaper.rasi"
SETTINGS_BLUR="$HOME/.config/xcloud/settings/blur.sh"
SETTINGS_WALLPAPER_FOLDER="$HOME/.config/xcloud/settings/wallpaper-folder"
BLUR=$(cat "$SETTINGS_BLUR" 2>/dev/null)
BLUR=${BLUR:-50x30}

# ============================================================
# Logging
# ============================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# ============================================================
# Functions
# ============================================================

show_help() {
    echo "Usage: xcloud-wallpaper PATH_TO_IMAGE [OPTIONS]"
    echo "  DEFAULT:               $DEFAULT_WALLPAPER"
    echo ""
    echo "Core Parameters:"
    echo "  PATH_TO_IMAGE          Path to the image file to set as wallpaper."
    echo ""
    echo "Optional Parameters:"
    echo "  --random [FOLDER]      Select a random image from FOLDER."
    echo "  --restore              Set the last wallpaper again (login); only re-themes"
    echo "                         if the blurred/square variants are missing."
    echo "  --notifications        Enable desktop notifications."
    echo "  --skip-wallpaper       Will skip setting the wallpaper with feh."
    echo "  --skip-theming         Will skip updating OS themes based on new wallpaper."
    echo "  --skip                 Alias for \"--skip-wallpaper\"."
    echo "  --help                 Show this help message and exit."
}

send_notification() {
    [ "$NOTIFICATIONS" = true ] || return
    notify-send -a "xcloud-wallpaper" -i "preferences-desktop-wallpaper-symbolic" "$1" "$2"
}

# The wallpaper folder setting (~/Pictures/wallpaper by default), or the
# wallpapers shipped with the system when that folder doesn't exist.
wallpaper_folder() {
    local raw folder
    raw=$(cat "$SETTINGS_WALLPAPER_FOLDER" 2>/dev/null)
    folder="${raw//\$HOME/$HOME}"
    folder="${folder//\~/$HOME}"
    if [[ -n "$folder" && -d "$folder" ]]; then
        echo "$folder"
    else
        echo "$SYSTEM_WALLPAPER_FOLDER"
    fi
}

set_wallpaper() {
    if [ "$SKIP_WALLPAPER" = true ]; then
        info "Wallpaper set skipped"
        return
    fi
    info "Setting wallpaper: $IMAGE_PATH"
    feh --no-fehbg --bg-fill "$IMAGE_PATH" || { error "feh failed"; return 1; }
}

run_matugen() {
    local theme_pref
    theme_pref=$(grep -E '^gtk-application-prefer-dark-theme=' "$HOME/.config/gtk-3.0/settings.ini" | awk -F'=' '{print $2}')

    local mode="light"

    case "$theme_pref" in
        1|true)
            mode="dark"
            ;;
    esac

    local bin="matugen"
    [ -f "$HOME/.cargo/bin/matugen" ] && bin="$HOME/.cargo/bin/matugen"
    [ -f "$HOME/.local/bin/matugen" ] && bin="$HOME/.local/bin/matugen"

    info "Running matugen in $mode mode"
    # --prefer is required: matugen's image-based extraction can find
    # multiple candidate source colors, and without a preference it
    # prompts interactively - which hangs/fails when run from a script
    # with no TTY (as this always is).
    "$bin" image "$IMAGE_PATH" -t scheme-content -m "$mode" --prefer=saturation
    info "Matugen updated"
}

generate_image_variants() {
    magick "$IMAGE_PATH" -resize 75% "$BLURRED_WALLPAPER"
    if [ "$BLUR" != "0x0" ]; then
        magick "$BLURRED_WALLPAPER" -blur "$BLUR" "$BLURRED_WALLPAPER"
    fi
    info "Blurred wallpaper created"
    magick "$IMAGE_PATH" -gravity Center -extent 1:1 "$SQUARE_WALLPAPER"
    info "Square wallpaper created"
    echo "* { current-image: url(\"$BLURRED_WALLPAPER\", height); }" > "$RASI_FILE"
    info "Rasi file updated"
}

# ============================================================
# Parameter Parsing
# ============================================================
[[ $# -eq 0 ]] && { show_help; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --skip|--skip-wallpaper)
            SKIP_WALLPAPER=true; shift ;;
        --skip-theming)
            SKIP_THEMING=true; shift ;;
        --restore)
            RESTORE=true; shift ;;
        --random)
            if [[ -n "$2" && "$2" != -* ]]; then
                RANDOM_FOLDER="$2"; shift 2
            else
                RANDOM_FOLDER=$(wallpaper_folder)
                shift 1
            fi
            if [[ ! -d "$RANDOM_FOLDER" ]]; then
                error "Directory does not exist -> $RANDOM_FOLDER"; exit 1
            fi
            IMAGE_PATH=$(find "$RANDOM_FOLDER" -maxdepth 1 -type f \
                \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | shuf -n 1)
            [[ -z "$IMAGE_PATH" ]] && { error "No valid images found in -> $RANDOM_FOLDER"; exit 1; }
            info "Random wallpaper selected: $IMAGE_PATH" ;;
        --notifications)
            NOTIFICATIONS=true; shift ;;
        --help)
            show_help; exit 0 ;;
        -*)
            error "Unknown option: $1"; show_help; exit 1 ;;
        *)
            if [[ -z "$IMAGE_PATH" ]]; then
                IMAGE_PATH="$1"
            else
                error "Multiple image paths provided -> $1"; exit 1
            fi
            shift ;;
    esac
done

# ============================================================
# Validation
# ============================================================
if [ "$RESTORE" = true ] && [[ -z "$IMAGE_PATH" ]]; then
    IMAGE_PATH=$(cat "$CACHE_FILE" 2>/dev/null)
    if [[ -n "$IMAGE_PATH" && ! -f "$IMAGE_PATH" ]]; then
        warn "Last wallpaper is gone -> $IMAGE_PATH"
        IMAGE_PATH=""
    fi
fi

if [[ -z "$IMAGE_PATH" ]]; then
    info "Using default wallpaper -> $DEFAULT_WALLPAPER"
    IMAGE_PATH="$DEFAULT_WALLPAPER"
fi

if [[ ! -f "$IMAGE_PATH" ]]; then
    error "Image file does not exist -> $IMAGE_PATH"; exit 1
fi

mkdir -p "$CACHE_FOLDER"

# ============================================================
# Main
# ============================================================
if [ "$RESTORE" = true ]; then
    # Login: just put the wallpaper back. The palette files persist in
    # ~/.config; only a new image (or missing variants) needs a re-theme.
    set_wallpaper
    if [ "$(cat "$CACHE_FILE" 2>/dev/null)" = "$IMAGE_PATH" ] && [ -f "$BLURRED_WALLPAPER" ] \
        && [ -f "$SQUARE_WALLPAPER" ]; then
        # A pre-seeded (e.g. /etc/skel) rasi may not point at this user's cache
        grep -qF "$BLURRED_WALLPAPER" "$RASI_FILE" 2>/dev/null || \
            echo "* { current-image: url(\"$BLURRED_WALLPAPER\", height); }" > "$RASI_FILE"
        info "Done"
        exit 0
    fi
    SKIP_WALLPAPER=true
fi

echo "$IMAGE_PATH" > "$CACHE_FILE"
info "Cache updated: $IMAGE_PATH"

set_wallpaper
if "$SKIP_THEMING"; then
    info "Updating theming skipped"
else
    run_matugen
    generate_image_variants
fi
send_notification "Wallpaper Updated" "$(basename "$IMAGE_PATH")"
info "Done"
