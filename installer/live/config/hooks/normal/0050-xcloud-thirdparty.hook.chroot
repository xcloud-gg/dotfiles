#!/bin/sh
# Packages not in trixie's archive, installed here (not via config/archives or
# the package list: live-build adds config/archives sources before
# ca-certificates exists in the chroot, so an https repo fails TLS there).
set -e
export DEBIAN_FRONTEND=noninteractive

# chezmoi — in Debian sid only, not trixie. Official upstream .deb, checksum-verified.
CHEZMOI_VERSION=2.72.2
tmp=$(mktemp -d)
base=https://github.com/twpayne/chezmoi/releases/download/v$CHEZMOI_VERSION
curl -fsSL -o "$tmp/chezmoi_${CHEZMOI_VERSION}_linux_amd64.deb" "$base/chezmoi_${CHEZMOI_VERSION}_linux_amd64.deb"
curl -fsSL -o "$tmp/checksums.txt" "$base/chezmoi_${CHEZMOI_VERSION}_checksums.txt"
(cd "$tmp" && grep " chezmoi_${CHEZMOI_VERSION}_linux_amd64.deb\$" checksums.txt | sha256sum -c -)
apt-get install -y "$tmp/chezmoi_${CHEZMOI_VERSION}_linux_amd64.deb"
rm -rf "$tmp"

# oh-my-posh (zsh prompt in the dotfiles) — not packaged in Debian. Upstream
# static binary, checksum-verified.
POSH_VERSION=31.3.0
tmp=$(mktemp -d)
base=https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/v$POSH_VERSION
curl -fsSL -o "$tmp/posh-linux-amd64" "$base/posh-linux-amd64"
curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"
(cd "$tmp" && grep " posh-linux-amd64\$" checksums.txt | sha256sum -c -)
install -m 0755 "$tmp/posh-linux-amd64" /usr/local/bin/oh-my-posh
rm -rf "$tmp"

# Docker CE — official repo, persistent for the installed system (deb822,
# same as the netinst late.sh). Rootless only: the system daemon is masked in
# 0400-xcloud-services.
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | grep -q '^fpr:::::::::9DC858229FC7DD38854AE2D88D81803C0EBFCD88:' \
    || { echo "FATAL: unexpected Docker signing key"; exit 1; }
chmod a+r /etc/apt/keyrings/docker.asc
cat > /etc/apt/sources.list.d/docker.sources <<SRC
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: trixie
Components: stable
Architectures: amd64
Signed-By: /etc/apt/keyrings/docker.asc
SRC
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-ce-rootless-extras
