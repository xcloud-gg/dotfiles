#!/bin/sh
# live-build lists every package not from config/package-lists as live-only
# (filesystem.packages-remove = chroot.packages.live minus .install), and d-i's
# remove-live-packages purges those from the installed system at finish. That
# took chezmoi and Docker (installed by hook 0050) off installed hosts, which
# left xcloud-first-login a silent no-op (seen in a libvirt test, 2026-09-27).
# Keep them. Runs in binary/, after binary_manifest wrote the list.
set -e
f=live/filesystem.packages-remove
[ -f "$f" ] || exit 0
grep -vxE 'chezmoi|containerd\.io|docker-[a-z-]+|pigz' "$f" > "$f.new" || true
mv "$f.new" "$f"
[ -s "$f" ] || rm -f "$f"
echo "packages-remove now: $(cat "$f" 2>/dev/null | tr '\n' ' ')"
