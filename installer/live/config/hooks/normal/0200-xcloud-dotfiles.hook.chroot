#!/bin/sh
# xcloud-gg/dotfiles for both accounts. Scripts are excluded here: the
# docker-rootless one exits 0 without a user session, and chezmoi would then
# record it as done forever. They run on first graphical login instead
# (xcloud-first-login.service, a global systemd --user unit).
set -e
REPO=https://github.com/xcloud-gg/dotfiles.git
for u in marius xcloud; do
    su - "$u" -c "chezmoi init --apply --exclude=scripts $REPO"
    test -f "/home/$u/.config/i3/config" || { echo "FATAL: dotfiles not applied for $u"; exit 1; }
done
# Pre-install the non-Debian apps for marius so first login doesn't wait on
# downloads. Same scripts chezmoi will run later (both skip when already present).
su - marius -c 'sh ~/.local/share/chezmoi/run_once_install-zen-browser.sh'
su - marius -c 'sh ~/.local/share/chezmoi/run_once_install-claude-code.sh'
# The repo's one-line installer and its modes (install.sh, bootstrap/), from the SAME
# commit as the applied rice. xcloud-firstboot runs bootstrap/agent-host.sh from here to
# fetch the signed agent kit, so first boot never pipes a download into a shell.
src=/home/marius/.local/share/chezmoi
dst=/usr/local/share/xcloud/dotfiles-bootstrap
rm -rf "$dst"; install -d -m 0755 "$dst"
cp -a "$src/install.sh" "$src/bootstrap" "$dst/"
su - marius -c "git -C $src rev-parse HEAD" > "$dst/REVISION"   # as the owner: git rejects root in a user-owned repo
chown -R root:root "$dst"
test -f "$dst/bootstrap/agent-host.sh" -a -f "$dst/bootstrap/lib.sh" || { echo "FATAL: dotfiles bootstrap/ missing"; exit 1; }
