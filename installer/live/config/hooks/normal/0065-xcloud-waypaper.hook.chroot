#!/bin/sh
# waypaper 2.9 (GPL-3.0; same version as Arch), wallpaper picker. Not in Debian.
# Plain venv, not pipx: trixie's pipx (1.7.1) force-upgrades pip from PyPI into
# its shared venv (unpinned download) and then rejected the --no-deps install
# ("No apps associated", tested 2026-09-28). The venv uses the system site
# packages for every dependency (python3-gi, gir1.2-gtk-3.0 — waypaper 2.9
# requires Gtk 3.0 — python3-pil, -platformdirs, -imageio, -screeninfo; all
# in the package list), and pip runs with --no-index, so the sha256-checked
# wheel is the only thing fetched. imageio-ffmpeg is a declared dependency
# that waypaper 2.9 never imports, so it is left out.
set -e
WAYPAPER_VERSION=2.9
WAYPAPER_SHA256=3455cb7b120a3b6bcaeddafb8e18bb415cd40187c9d9be106e528ba93b0e529f
WAYPAPER_URL=https://files.pythonhosted.org/packages/05/39/475b4ed28cd83c4b72d36859c0d97b9d37aa59d11f34c0850453034e2f18/waypaper-$WAYPAPER_VERSION-py3-none-any.whl
VENV=/opt/waypaper
tmp=$(mktemp -d)
whl="$tmp/waypaper-$WAYPAPER_VERSION-py3-none-any.whl"
curl -fsSL -o "$whl" "$WAYPAPER_URL"
echo "$WAYPAPER_SHA256  $whl" | sha256sum -c -
rm -rf "$VENV"
python3 -m venv --system-site-packages "$VENV"
"$VENV/bin/python" -m pip --no-input --disable-pip-version-check --no-cache-dir \
    install --no-index --no-deps "$whl"
rm -rf "$tmp"
ln -sf "$VENV/bin/waypaper" /usr/local/bin/waypaper
ln -sf "$VENV/bin/waypaperd" /usr/local/bin/waypaperd
# Every runtime import resolves (no display needed for this).
"$VENV/bin/python" -c 'import gi; gi.require_version("Gtk", "3.0"); from gi.repository import Gtk, GdkPixbuf; import PIL, imageio, screeninfo, platformdirs, waypaper'
test "$("$VENV/bin/python" -c 'import importlib.metadata as m; print(m.version("waypaper"))')" = "$WAYPAPER_VERSION"
