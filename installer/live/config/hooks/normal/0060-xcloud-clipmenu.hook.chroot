#!/bin/sh
# clipmenu (cdown/clipmenu, C rewrite on `develop`; not packaged in Debian) for
# minimal/CLI-leaning setups. The i3 desktop uses copyq (package list) instead,
# so clipmenud is installed but not enabled: `systemctl --user enable --now clipmenud`.
set -e
export DEBIAN_FRONTEND=noninteractive
CLIPMENU_COMMIT=e0ec3bc6608ecc70ed17e8da76e27bf90b1e8e90
CLIPMENU_SHA256=255c61ffa4e17dfbce82d567f99441b273712c43457f34c3cc9604559fd5cc8c
# Build-only dev packages this hook adds itself (gcc/make stay: DKMS needs them).
added=""
for p in libx11-dev libxfixes-dev; do
    dpkg -s "$p" >/dev/null 2>&1 || added="$added $p"
done
apt-get install -y --no-install-recommends make gcc libc6-dev libx11-dev libxfixes-dev
tmp=$(mktemp -d)
curl -fsSL -o "$tmp/cm.tgz" "https://github.com/cdown/clipmenu/archive/$CLIPMENU_COMMIT.tar.gz"
echo "$CLIPMENU_SHA256  $tmp/cm.tgz" | sha256sum -c -
mkdir "$tmp/src"
tar xzf "$tmp/cm.tgz" -C "$tmp/src" --strip-components=1
make -C "$tmp/src"
make -C "$tmp/src" install PREFIX=/usr/local
rm -rf "$tmp"
[ -n "$added" ] && apt-get purge -y $added
test -x /usr/local/bin/clipmenud && test -f /usr/local/lib/systemd/user/clipmenud.service
