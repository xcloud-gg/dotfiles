#!/bin/bash
# xcloud-firstboot — runs once, on tty1, before the display manager, on a host
# installed from the xCloud live ISO. Does everything that must be unique per
# host and so can't be baked into the image. Log: /var/log/xcloud-firstboot.log
set -uo pipefail
LOG=/var/log/xcloud-firstboot.log
KIT=/root/xcloud-agent-kit
exec > >(tee -a "$LOG") 2>&1
chvt 1 2>/dev/null || true

fail() {
    echo; echo "!! xcloud-firstboot FAILED: $*"
    echo "!! Log: $LOG. Fix, then re-run: /usr/local/sbin/xcloud-firstboot"
    echo "!! Dropping to a root shell; the display manager will NOT start until this succeeds."
    /bin/bash -l </dev/tty1 >/dev/tty1 2>&1
    exit 1
}

echo "=== xcloud-firstboot: $(date) on $(hostname) ==="

echo "--- per-host identity: machine-id, SSH host keys ---"
[ -s /etc/machine-id ] || systemd-machine-id-setup || fail "machine-id"
ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1 || dpkg-reconfigure -f noninteractive openssh-server || fail "ssh host keys"

echo "--- waiting for network (needed: bootstrap-host.sh downloads Claude Code) ---"
for i in $(seq 1 60); do
    curl -fsS -o /dev/null --max-time 3 https://deb.debian.org/ && break
    [ "$i" = 60 ] && fail "no network after 60s — plug in ethernet or run nmtui, then re-run"
    sleep 1
done

echo; echo "--- password for marius (desktop user) ---"
until passwd marius; do echo "try again"; done

host=$(hostname -s)
case "$host" in
    thor) roles=platform,aios-thor ;;
    *)    roles=aios-debian ;;
esac
echo; echo "Hostname '$host' -> agent-kit roles: $roles"
read -r -p "Use these roles? [Y/n/custom] " ans </dev/tty1
case "$ans" in
    ""|y|Y) ;;
    n|N) fail "aborted by operator" ;;
    *) roles=$ans ;;
esac

# Agent kit: prefer the newest SIGNED kit-* tag of xc0-sh/xcloud-docs (fetched and verified by the
# dotfiles repo's bootstrap/agent-host.sh, baked in by hook 0200), so a host gets the current kit
# without an ISO rebuild. It needs the operator's signing key baked in at build time (live/signer.pub),
# the network, a GitHub device login, and a published kit-* tag; otherwise, or if it fails, fall back
# to the kit baked into this ISO. Both paths run bootstrap-host.sh, which also sets xcloud's password.
SIGNER=/usr/local/share/xcloud/signer.pub
AGENTHOST=/usr/local/share/xcloud/dotfiles-bootstrap/bootstrap/agent-host.sh
kit_done=""
if [ -s "$SIGNER" ] && [ -f "$AGENTHOST" ]; then
    fpr=$(ssh-keygen -lf "$SIGNER" | awk '{print $2}')
    echo; echo "--- agent kit ---"
    echo "Signed kit: newest kit-* tag of xc0-sh/xcloud-docs, verified against the signing key"
    echo "baked into this ISO:  $fpr  ($(awk '{print $3}' "$SIGNER"))"
    echo "It needs a GitHub device login (you finish it in a browser elsewhere); the login is removed after."
    read -r -p "Does that fingerprint match your records, and use the signed kit? [Y/n] " ans </dev/tty1
    case "$ans" in
        ""|y|Y)
            echo "--- bootstrap/agent-host.sh --roles $roles (dotfiles $(cat "${AGENTHOST%/bootstrap/agent-host.sh}/REVISION" 2>/dev/null | cut -c1-12)) ---"
            if bash "$AGENTHOST" --roles "$roles" --operator-key "$KIT/operator.pub" \
                    --signer-key "$(cat "$SIGNER")" --fingerprint "$fpr" --claude-version stable </dev/tty1; then
                kit_done=signed
            else
                echo "!! the signed kit did not install (see above)."
                read -r -p "Fall back to the kit baked into this ISO? [Y/n] " ans </dev/tty1
                case "$ans" in ""|y|Y) ;; *) fail "signed kit failed and fallback declined" ;; esac
            fi ;;
    esac
fi
if [ -z "$kit_done" ]; then
    echo; echo "--- bootstrap-host.sh --roles $roles, kit baked into this ISO (sets xcloud's password too) ---"
    "$KIT/bootstrap/bootstrap-host.sh" --roles "$roles" --operator-key "$KIT/operator.pub" --claude-version stable \
        </dev/tty1 || fail "bootstrap-host.sh"
    kit_done=baked
fi

echo "--- checks ---"
visudo -c || fail "visudo -c"
id -nG marius | grep -qwE 'aios|docker' && fail "marius is in aios/docker (aiOS invariant 12)"
stat -c '%A %U:%G %n' /opt/claude /opt/claude/xcloud
sudo -l -U xcloud

{
    echo "xcloud-firstboot $(date -Is) on $host, roles $roles, kit $kit_done — PUBLIC keys only"
    su - xcloud -c 'grep -h "public key" ~/.config/sops/age/keys.txt' 2>/dev/null
    cat /home/xcloud/.ssh/*.pub 2>/dev/null
} > /root/xcloud-firstboot.txt
chmod 0600 /root/xcloud-firstboot.txt

mkdir -p /var/lib/xcloud && touch /var/lib/xcloud/firstboot.done
echo; echo "=== done. Public keys saved to /root/xcloud-firstboot.txt. Next: log in as xcloud, run claude to sign in; netbird enrollment per the kit README."
read -r -p "Press Enter to start the desktop." _ </dev/tty1
