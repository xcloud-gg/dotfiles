#!/bin/sh
# xCloud: live-config's 0085-sddm writes /etc/sddm.conf's [Autologin] with an
# empty Session= for anything but Plasma/LXQt, and SDDM then finds no session
# on a fresh live boot and shows the greeter. Point it at i3. Live session only:
# live-config is purged from the installed system (late.sh), so this never runs there.

. /usr/lib/live/config.sh

if component_was_executed "xcloud-sddm-session"
then
	exit 0
fi

if [ -f /etc/sddm.conf ]
then
	sed -i -e 's/^Session=$/Session=i3.desktop/' /etc/sddm.conf
fi

touch /var/lib/live/config/xcloud-sddm-session
