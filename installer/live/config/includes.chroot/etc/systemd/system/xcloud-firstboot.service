[Unit]
Description=xCloud first boot: host keys, passwords, agent-kit bootstrap
# Skip in the live session (live-boot puts boot=live on the cmdline) and once done.
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/var/lib/xcloud/firstboot.done
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Before=display-manager.service ssh.service getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
# plymouth still owns the console here (it quits when boot finishes, which
# this unit blocks, and lightdm Conflicts= plymouth-quit.service), so passwd
# on tty1 got no input and looped on "passwords do not match".
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/local/sbin/xcloud-firstboot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutSec=0

[Install]
WantedBy=multi-user.target
