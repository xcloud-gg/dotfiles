# Mirrors xcloud-gg/dotfiles:DEBIAN-PACKAGES.md — keep them in sync.

# Desktop / WM
xorg i3-wm i3lock i3status
polybar picom dunst rofi nitrogen feh
# display manager: SDDM + the vendored ml4w theme's Qt6/QML deps
# (includes.chroot/usr/share/sddm/themes/ml4w); sddm-theme-maui satisfies sddm's
# Recommends "sddm-theme-debian-breeze | sddm-theme" (the breeze one pulls plasma-workspace)
sddm sddm-theme-maui
qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts
qml6-module-qtquick-effects qml6-module-qtquick-virtualkeyboard qt6-virtualkeyboard-plugin
qml6-module-qtmultimedia qt6-svg-plugins
# Quickshell (the rice's bar/shell) QML runtime + services it talks to
qml6-module-qtquick-templates qml6-module-qtquick-window qml6-module-qtquick-shapes
qml6-module-qtqml-workerscript upower power-profiles-daemon
# the bar (dotfiles i3 config starts it): our own trixie build of v0.3.1 in
# config/packages.chroot, provenance in config/quickshell-build. Listed so a
# missing .deb fails the build instead of shipping an image with no bar.
quickshell
# Caps Lock tap/hold (includes.chroot/etc/keyd/default.conf, as on loki)
keyd
# desktop apps/services the Arch rice uses
lxpolkit gammastep nautilus loupe gnome-text-editor gnome-calculator
xdg-desktop-portal-gtk blueman kde-style-breeze sound-theme-freedesktop
# wallpaper: imagemagick (magick; xcloud-wallpaper + hook 0270), waypaper
# (hook 0065, venv on these system packages; waypaper 2.9 uses Gtk 3)
imagemagick python3-venv python3-gi gir1.2-gtk-3.0 gir1.2-gdkpixbuf-2.0
python3-pil python3-platformdirs python3-imageio python3-screeninfo
xss-lock numlockx x11-xserver-utils xdg-utils xsettingsd
network-manager network-manager-gnome
pulseaudio pulseaudio-utils pavucontrol playerctl
brightnessctl maim xclip
# clipboard history: copyq on the desktop (SUPER+V); clipmenu is built in hook 0060
copyq

# Terminal / shell / editors
kitty tmux fish zsh neovim vim git curl ca-certificates sudo
# used by the dotfiles' zshrc/aliases (oh-my-posh: hook 0050; oh-my-zsh: hook 0250)
fzf zoxide direnv atuin eza fastfetch

# Fonts / theming
fonts-jetbrains-mono fonts-font-awesome fonts-noto-color-emoji
# papirus stays: Quickshell's QS_ICON_THEME is Papirus-Dark. kora (the GTK icon
# theme) is fetched in hook 0055; breeze-icon-theme is what kora Inherits=
papirus-icon-theme bibata-cursor-theme breeze-icon-theme
# fonts/icon caches for the vendored Fira Sans, JetBrainsMono Nerd Font, kora (hook 0055)
fontconfig gtk-update-icon-cache
gtk2-engines-murrine gnome-themes-extra qt6ct

# Portability / drivers
firmware-linux firmware-misc-nonfree
autorandr zram-tools
mesa-utils libgl1-mesa-dri xserver-xorg-video-all
unattended-upgrades firefox-esr chromium
# chezmoi: not in trixie (sid only) — upstream .deb in hook 0050

# NVIDIA (decision 2026-09-27: baked into the image; only binds where the
# hardware exists; DKMS builds against the image kernel — see README.md)
nvidia-driver linux-headers-amd64 mokutil

# Filesystem / encryption / boot — the installed system is a copy of this
# squashfs, so everything the LUKS2 -> LVM -> Btrfs root needs must be here
btrfs-progs cryptsetup cryptsetup-initramfs lvm2 tpm2-tools efibootmgr

# Locale / keyboard for the installed system
locales console-setup keyboard-configuration

# Docker: docker-ce & co. come from Docker's repo in hook 0050 (rootless only);
# the Debian-side rootless prerequisites are here
uidmap dbus-user-session slirp4netns gpg
# dockerd-rootless-setuptool.sh refuses to run without iptables (seen in QEMU)
iptables

# Agent kit: everything bootstrap-host.sh apt-installs on Debian, so its
# first-boot apt run is a no-op; plus the ssh server
gnupg jq rsync acl e2fsprogs util-linux logrotate age openssh-client openssh-server bsdutils

# Live system (purged from the installed target by late.sh)
live-boot live-config live-config-systemd
