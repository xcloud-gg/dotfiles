#!/bin/sh
# live-build config for the xCloud Debian 13 live ISO — see ../README.md.
# --debian-installer live: d-i with live-installer, which copies this squashfs to
# the target instead of installing packages over the network.
set -e
lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap http://deb.debian.org/debian \
	--mirror-binary http://deb.debian.org/debian \
	--firmware-chroot true \
	--firmware-binary true \
	--bootloaders grub-pc,grub-efi \
	--debian-installer live \
	--debian-installer-gui false \
	--bootappend-live "boot=live components quiet username=marius locales=en_US.UTF-8 keyboard-layouts=no timezone=Europe/Oslo" \
	--bootappend-install "locale=en_US.UTF-8 keymap=no" \
	--image-name xcloud-live \
	--iso-volume "xcloud-live" \
	--iso-application "xCloud Debian 13 live" \
	"${@}"
